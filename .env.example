# Backend Environment Variables
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://psi_user:psi_password@localhost:5432/psi_db

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# File Upload
MAX_FILE_SIZE=50mb
UPLOAD_DIR=./uploads

# Frontend
VITE_API_URL=http://localhost:3001
